<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lugares</title>
</head>
<body>
      <h1>Tabla de lugares</h1>

    <table border="1">
    <thead>  
    <tr>
    <th>ID</th>
    <th>Nombre del lugar</th>
    <th>Editar</th>
    <th>Eliminar</th>
</tr></thead>  
    <tbody>
        <tr>
         <% lugares.forEach(function(lugar) { %>  
            <td><%= lugar.id %></td>
            <td><%= lugar.nombre %></td>
            <td> <a href="/editarlugar/<%= lugar.id %>"><button>Editar</button></a></td>
            <td><form action="/eliminarlugar/<%= lugar.id %>" method="POST" >
                            <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este cargo?');">
                                Eliminar
                            </button>
                        </form></td>
                        </tr>
            <% }); %>
    </tbody>
</table>


<a href="/crearlugar">Nuevo lugar</a><br>

<a href="/">Volver</a>
</body>
</html>