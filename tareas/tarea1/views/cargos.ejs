<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cargos</title>
</head>
<body>
    <h1>Tabla de cargos</h1>

    <table border="1">
    <thead>  
    <tr>
    <th>ID</th>
    <th>Nombre del cargo</th>
    <th>Editar</th>
    <th>Eliminar</th>
</tr></thead>  
    <tbody>
        <tr>
        <% cargos.forEach(function(cargo) { %>  
            <td><%= cargo.id %></td>
            <td><%= cargo.nombre %></td>
            <td> <a href="/editarcargo/<%= cargo.id %>"><button>Editar</button></a></td>
            <td><form action="/eliminarcargo/<%= cargo.id %>" method="POST" >
                            <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este cargo?');">
                                Eliminar
                            </button>
                        </form></td></tr>
            <% }); %>
    </tbody>
</table>
    <a href="/crearcargo">Nuevo cargo</a><br>
    <a href="/">Volver</a>
</body>
</html>