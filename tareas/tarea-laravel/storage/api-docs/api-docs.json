{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Gestión de Empleados",
        "description": "Demostración de API REST con Swagger y MongoDB",
        "version": "1.0.0"
    },
    "paths": {
        "/api/empleados": {
            "get": {
                "tags": [
                    "Empleados"
                ],
                "summary": "Listar todos los empleados",
                "operationId": "843734bf35749b554c0f44b8631d7492",
                "responses": {
                    "200": {
                        "description": "Operación exitosa"
                    }
                }
            },
            "post": {
                "tags": [
                    "Empleados"
                ],
                "summary": "Registrar un nuevo empleado",
                "operationId": "797a90b42ba6eabad784c56e6287912f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "puesto",
                                    "salario"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "María López"
                                    },
                                    "puesto": {
                                        "type": "string",
                                        "example": "Desarrolladora React"
                                    },
                                    "salario": {
                                        "type": "number",
                                        "example": 6000.5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Empleado creado"
                    }
                }
            }
        },
        "/api/empleados/{id}": {
            "put": {
                "tags": [
                    "Empleados"
                ],
                "summary": "Actualizar los datos de un empleado",
                "operationId": "3e0e39beedb373ee431d344063fbfe01",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del empleado",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "María López"
                                    },
                                    "puesto": {
                                        "type": "string",
                                        "example": "Líder Técnica"
                                    },
                                    "salario": {
                                        "type": "number",
                                        "example": 8500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Empleado actualizado con éxito"
                    },
                    "404": {
                        "description": "Empleado no encontrado"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Empleados"
                ],
                "summary": "Eliminar un empleado",
                "operationId": "5561b5ce018c7ad8a2ccbd86fe1682e9",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del empleado a eliminar",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Empleado eliminado exitosamente"
                    },
                    "404": {
                        "description": "Empleado no encontrado"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Empleados",
            "description": "Empleados"
        }
    ]
}